DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-generated-locally
DJANGO_ALLOWED_HOSTS=zeitung.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://zeitung.example.invalid
DJANGO_TRUST_PROXY_PROTO=true
# Enable after HTTPS and certificate renewal have been verified.
DJANGO_HSTS_SECONDS=0
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=kaktus
PGUSER=kaktus_app
PGPASSWORD=replace-locally
PGSSLMODE=require
# Set only after observing the actual immediate proxy peer in this topology.
TRUSTED_PROXY_NETWORKS=
SUBMISSION_RETENTION_DAYS=0
REACTION_RETENTION_DAYS=0
RETENTION_CONFIRMED=false
