DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGHOST=
PGPORT=5432
PGDATABASE=kaktus_dev
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
# Dedicated disposable database; never an existing application database.
PGTESTDATABASE=kaktus_test
KAKTUS_TEST_DATABASE_CONFIRMED=false
