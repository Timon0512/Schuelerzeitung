DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_PROTO=false
DJANGO_HSTS_SECONDS=0
PGHOST=
PGPORT=5432
PGDATABASE=kaktus_dev
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
# Dedicated disposable database; never an existing application database.
PGTESTDATABASE=kaktus_test
KAKTUS_TEST_DATABASE_CONFIRMED=false

# Public interactions: tighten limits here if needed (field/image model ceilings apply).
SUBMISSION_NAME_LIMIT=120
SUBMISSION_CLASS_LIMIT=40
SUBMISSION_TITLE_LIMIT=200
SUBMISSION_BODY_LIMIT=50000
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=25000000
SUBMISSION_REQUEST_BYTES=11534336
HEART_REQUEST_BYTES=4096
INTERACTION_MAX_FIELDS=20
SUBMISSION_RATE_LIMIT=5
SUBMISSION_RATE_SECONDS=3600
HEART_RATE_LIMIT=60
HEART_RATE_SECONDS=60
# Empty by default. Only list actual trusted reverse-proxy addresses/CIDRs.
# The proxy must overwrite/append X-Forwarded-For correctly; never use 0.0.0.0/0.
TRUSTED_PROXY_NETWORKS=
HEART_COOKIE_AGE=31536000
# 0 disables deletion of the respective records. School must approve durations.
SUBMISSION_RETENTION_DAYS=0
REACTION_RETENTION_DAYS=0
RETENTION_CONFIRMED=false
